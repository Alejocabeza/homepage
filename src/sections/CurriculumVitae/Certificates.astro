---
import Section from "@/components/CurriculumVitae/Section.astro";
import { certificates } from "@cv";
---

<Section title="Certificados">
  <ul class='flex flex-col gap-[32px] px-4 md:px-0'>
    {
      certificates.map(({ date, name, issuer }) => {
        const year = new Date(date).getFullYear();
        return (
          <li>
            <article>
              <header class='flex flex-col items-center gap-1 mb-[4px] md:flex-row md:justify-between md:items-center'>
                <h3 class='font-normal text-[#111] text-center'>{name}</h3>
                <time class='text-[#555] text-[.85rem] min-w-[102px] text-center md:text-end'>{year}</time>
              </header>
            </article>
          </li>
        );
      })
    }
  </ul>
</Section>
