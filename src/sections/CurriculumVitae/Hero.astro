---
import {basics} from '@cv';
import Section from '@/components/CurriculumVitae/Section.astro';

---

<Section>
    <div class="mt-32 flex flex-row items-center justify-between gap-4">
        <div class="flex flex-col gap-2 pr-8">
            <h1 class="text-[2rem] font-bold">{basics.name}</h1>
            <h2 class="text-[1.1rem] text-[#444] font-medium text-wrap">{basics.label}</h2>
            <span class="text-[#666] flex items-center gap-1 text-[.85rem] tracking-tighter">
                {basics.location.city}, {basics.location.region}
            </span>
        </div>
        <figure>
            <img class="aspect-square object-cover w-32 rounded-2xl" src={basics.image} alt={basics.name} />
        </figure>
    </div>
</Section>