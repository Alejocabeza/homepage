---
import Section from "@/components/CurriculumVitae/Section.astro";
import { languages } from "@cv";
---

<Section title="Idiomas">
  {
    languages.map(({ language, fluency }) => (
        <div class='flex justify-center items-center gap-1 mt-[.8rem] md:justify-start'>
          <h3 class='font-bold'>{language}</h3> -<span class='text-[.8rem]'>{fluency}</span>
        </div>
    ))
  }
</Section>
