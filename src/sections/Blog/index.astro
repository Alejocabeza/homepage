---
import Cards from "@/components/blog/Cards.astro";
import SectionContainer from "@/components/ui/SectionContainer.astro";
import SectionTitle from "@/components/ui/SectionTitle.astro";
import { getAllPosts } from "@/services/notion";
import { Public } from "@/enums/Public.enum";
const posts = await getAllPosts();
---

<SectionContainer class="py-32 md:py-36 max-w-full px-4 md:px-0">
  <SectionTitle>Blog</SectionTitle>
  <p class="mb-3">
    Busca en mi blog el contenido que te interese, deja tu consulta
  </p>
  <div class="grid md:grid-cols-2 gap-4">
    {
      posts.results.map((post) => {
        if (
          post.archived !== true &&
          post.in_trash !== true &&
          post.properties.public.status.name !== "not_public"
        ) {
          return <Cards {...post} />;
        }
      })
    }
  </div>
</SectionContainer>
