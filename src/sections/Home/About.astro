---
import { basics } from "@cv";
import SectionContainer from "@/components/ui/SectionContainer.astro";
import SectionTitle from "@/components/ui/SectionTitle.astro";

---

<SectionContainer class="py-32 md:py-36 px-20 sm:px-0">
  <SectionTitle>Sobre Mi</SectionTitle>
  <article
    class="flex flex-col items-center justify-center gap-8 text-gray-700 dark:text-gray-300 md:flex-row mt-16"
  >
    <div
      class="[&>p]:mb-4 [&>p>strong]:text-pink-500 dark:[&>p>strong]:text-pink-100 [&>p>strong]:font-normal [&>p>strong]:font-mono order-2 md:order-1 text-pretty"
    >
      {basics.aboutMe.map((text) => (
        <p>{text}</p>
      ))}
    </div>

    <img
      width="200"
      height="200"
      src={basics.image}
      alt={basics.name}
      class="order-1 object-cover w-64 h-full p-1 md:order-2 rotate-3 lg:p-2 lg:w-64 aspect-square rounded-2xl bg-black/20 dark:bg-pink-500/5 ring-1 ring-black/70 dark:ring-white/20 mb-8 sm:mb-0"
      style="object-position: 50% 50%"
    />
  </article>
</SectionContainer>
