---
import ExperienceItem from "@/components/Home/ExperienceItem.astro";
import { work } from "@cv";
import SectionContainer from "@/components/ui/SectionContainer.astro";
import SectionTitle from "@/components/ui/SectionTitle.astro";
---

<SectionContainer class='px-4 md:px-0'>
  <SectionTitle>
    Experiencia
  </SectionTitle>
  <ol class="relative mt-16">
    {
      work.map((experiencie) => (
        <li>
          <ExperienceItem {...experiencie} />
        </li>
      ))
    }
  </ol>
</SectionContainer>
