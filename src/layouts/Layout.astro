---
import "@fontsource-variable/onest";
import Header from "@/components/ui/header.astro";
import Analytics from "@vercel/analytics/astro";
import { ViewTransitions } from "astro:transitions";

interface Props {
  title: string;
  description: string;
  lang: "es" | "en";
}

const { description, title, lang } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <Analytics />
    <ViewTransitions />
  </head>

  <body class="relative text-text-primary bg-primary">
    <div
      class="absolute top-0 bottom-0 z-[-2] min-h-screen w-full
      bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(100,255,218,0.2),rgba(255,255,255,0))]"
    >
    </div>
    <Header lang={lang} />
    <main class="max-w-[700px] mx-auto">
      <slot />
    </main>
    <style is:global>
      :root {
        color-scheme: light dark;
      }

      html {
        font-family: "Onest Variable", system-ui, sans-serif;
        scroll-behavior: smooth;
      }

      body {
        color: #ccd6f6;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        overscroll-behavior: none;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }

      #header-nav {
        animation: blur linear both 0.5s;
        animation-timeline: scroll();
        animation-range: 0 500px;
      }

      @keyframes blur {
        to {
          backdrop-filter: blur(20px);
          border-width: 1px;
          border-color: #64ffda;
          padding: 0.25rem 0.75rem;
          display: flex;
          flex-direction: row;
          align-items: center;
          background-color: rgba(10, 25, 47, 0.85);
          border-radius: 9999px;
        }
      }

      code {
        color: #ffffff !important;
        background-color: transparent;
        padding: 0.2em 0.4em;
        border-radius: 3px;
        font-family: monospace;
      }
    </style>
    <script type="module" src="/scripts/mermaid-init.js"></script>
  </body>
</html>
