---
import marked from "@/shared/lib/marked";
import {
  getPublishedProjects,
  getProjectBySlug,
  type Project,
} from "@/shared/lib/notion";
import Layout from "@/shared/layouts/index.layout.astro";
import ProjectItemPage from "@/feature/projects/pages/project-item.astro";
import siteMetadata, { absoluteUrl } from "@/shared/config/site";

export async function getStaticPaths() {
  const projects = await getPublishedProjects();
  const locales = ["en", "es"]; // Asumimos que cada proyecto está disponible en ambos idiomas

  const paths = [];
  for (const project of projects) {
    for (const locale of locales) {
      paths.push({
        params: { slug: project.slug, locale },
      });
    }
  }
  return paths;
}

const { slug, locale } = Astro.params;

if (!slug) {
  return Astro.redirect("/404");
}

const project: Project|null = await getProjectBySlug(slug);

if (!project) {
  return Astro.redirect("/404");
}

let renderedContent = await marked(project.content || "");
if (project.htmlPlaceholders) {
  project.htmlPlaceholders.forEach((originalHtml, index) => {
    const placeholder = `__HTML_CODE_PLACEHOLDER_${index}__`;
    if (typeof renderedContent === "string") {
      renderedContent = renderedContent.replace(placeholder, originalHtml);
    }
  });
}

const projectUrl = absoluteUrl(Astro.url.pathname || `/projects/${slug}`);
const projectDescription = project.description || siteMetadata.description;

const projectSchema = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "@id": `${projectUrl}#proyecto`,
  url: projectUrl,
  name: project.name,
  description: projectDescription,
  creator: {
    "@type": "Person",
    name: siteMetadata.author,
    url: siteMetadata.baseUrl,
  },
  inLanguage: siteMetadata.locale,
  keywords: project.stack,
  about: project.stack,
  sameAs: project.url ? [project.url] : undefined,
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Inicio",
      item: siteMetadata.baseUrl,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Proyectos",
      item: absoluteUrl("/projects"),
    },
    {
      "@type": "ListItem",
      position: 3,
      name: project.name,
      item: projectUrl,
    },
  ],
};
---
<Layout
  title={project.name}
  description={projectDescription}
  structuredData={[projectSchema, breadcrumbSchema]}
  keywords={[...siteMetadata.keywords, ...(project.stack ?? [])]}
>
  <ProjectItemPage project={project} renderedContent={renderedContent} />
</Layout>
