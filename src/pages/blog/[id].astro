---
import SectionContainer from "@/components/ui/SectionContainer.astro";
import SectionTitle from "@/components/ui/SectionTitle.astro";
import Layout from "@/layout/index.astro";
import { getPost, getBlocks } from "@/services/notion";
import { boolean } from "astro/zod";

const { id } = Astro.params;
const post = await getPost(id);
const blocks = await getBlocks(id);
---

<Layout title={`Blog - ${post.properties.name.title[0].plain_text}`} description={post.properties.description.rich_text[0].plain_text}>
  <SectionContainer
    class="py-32 md:py-36 w-full flex justify-center items-start flex-col max-w-full px-4 md:px-0"
  >
    <h1 class="text-[3rem] mb-8">
      {post.properties.name.title[0].plain_text}
    </h1>
    {
      blocks.results.map((block) => {
        if (block.type === "heading_1")
          return <h1>{block.heading_1?.rich_text[0].plain_text}</h1>;
        if (block.type === "heading_2")
          return <h2>{block.heading_2?.rich_text[0].plain_text}</h2>;
        if (block.type === "heading_3")
          return <h3>{block.heading_3?.rich_text[0].plain_text}</h3>;
        if (
          block.type === "paragraph" &&
          block.paragraph?.rich_text &&
          block.paragraph?.rich_text.length > 0
        )
          return <p>{block.paragraph?.rich_text[0].plain_text}</p>;
        if (block.type === "paragraph") return <br />;
        if (block.type === "bulleted_list_item")
          return (
            <ul>
              <li>
                <p>{block.bulleted_list_item?.rich_text[0].plain_text}</p>
              </li>
            </ul>
          );
        if (block.type === "numbered_list_item")
          return (
            <ol>
              <li>
                <p>{block.numbered_list_item?.rich_text[0].plain_text}</p>
              </li>
            </ol>
          );
        if (block.type === "to_do")
          return (
            <div>
              <label for={block.id}>
                <input
                  type="checkbox"
                  id={block.id}
                  checked={block.to_do?.checked}
                  disabled
                />
                {block.to_do?.rich_text[0].plain_text}
              </label>
            </div>
          );
        if (block.type === "image")
          return (
            <figure>
              <img
                src={
                  block.image?.external
                    ? block.image?.external.url
                    : block.image?.file && block.image?.file.url
                }
              />
            </figure>
          );
      })
    }
  </SectionContainer>
</Layout>

<style>
  h1 {
    font-size: 3rem;
    font-weight: bold;
    margin: 1rem 0;
  }
  h2 {
    font-size: 2rem;
    font-weight: bold;
    margin: 1rem 0;
  }
  h3 {
    font-size: 1.5rem;
    font-weight: bold;
    margin: 1rem 0;
  }
  p {
    text-align: justify;
    line-height: 1.8rem;
  }

  ul > li {
    list-style-type: disc;
  }

  ol > li {
    list-style-type: decimal;
  }

  @media screen and (max-width: 768px) {
    h1 {
      font-size: 2rem;
    }
    h2 {
      font-size: 1.5rem;
    }
    h3 {
      font-size: 1.2rem;
    }
    p {
      font-size: 0.9rem;
    }
  }
</style>
