---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/ui/container.astro";
import { findOneData, findAllBlock } from "@/services/notion";
import type { Blocks } from "@/interfaces/block.interface";
import type { Blog } from "@/interfaces/blog.interface";

const { id } = Astro.params;
const project: Blog = await findOneData(id as string);
const blocks: Blocks = await findAllBlock(id as string);
---

<Layout
  title={`Project - ${project.properties.Name.title[0].plain_text}`}
  description={project.properties.Description.rich_text[0].plain_text}
>
  <Container
    class="py-14 md:py-14 w-full flex justify-center items-start flex-col max-w-full px-4 md:px-0"
  >
    <h1 class="text-[2.5rem] font-bold">
      {project.properties.Name.title[0].plain_text}
    </h1>
    {
      blocks.results.map((block) => {
        switch (block.type) {
          case "heading_1":
            return (
              <h1 class="notion-heading-1">
                {block.heading_1?.rich_text[0]?.plain_text || ""}
              </h1>
            );
          case "heading_2":
            return (
              <h2 class="notion-heading-2">
                {block.heading_2?.rich_text[0]?.plain_text || ""}
              </h2>
            );
          case "heading_3":
            return (
              <h3 class="notion-heading-3">
                {block.heading_3?.rich_text[0]?.plain_text || ""}
              </h3>
            );
          case "paragraph":
            return block.paragraph?.rich_text.length > 0 ? (
              <p class="notion-paragraph">
                {block.paragraph.rich_text[0]?.plain_text || ""}
              </p>
            ) : (
              <br />
            );
          case "bulleted_list_item":
            console.log(block.bulleted_list_item);
            return (
              <ul class="notion-bulleted-list">
                <li class="notion-list-item">
                  {block.bulleted_list_item?.rich_text.map((text) => {
                    return <span>{text.plain_text}</span>;
                  })}
                </li>
              </ul>
            );
          case "numbered_list_item":
            return (
              <ol class="notion-numbered-list">
                <li class="notion-list-item">
                  {block.numbered_list_item?.rich_text.map((text) => {
                    return <span>{text.plain_text}</span>;
                  })}
                </li>
              </ol>
            );
          case "to_do":
            return (
              <div class="notion-to-do">
                <label>
                  <input
                    type="checkbox"
                    disabled
                    checked={block.to_do?.checked || false}
                  />
                  {block.to_do?.rich_text.map((text) => {
                    return <span>{text.plain_text}</span>;
                  })}
                </label>
              </div>
            );
          case "quote":
            return (
              <blockquote class="notion-quote">
                {block.quote?.rich_text[0]?.plain_text || ""}
              </blockquote>
            );
          case "divider":
            return <hr class="notion-divider" />;
          case "code":
            return (
              <pre class="notion-code">
                <code>{block.code?.rich_text[0]?.plain_text || ""}</code>
              </pre>
            );
          case "image":
            return (
              <figure class="notion-image">
                <img
                  src={
                    block.image?.external?.url || block.image?.file?.url || ""
                  }
                  alt=""
                />
              </figure>
            );
          case "callout":
            return (
              <div class="notion-callout">
                {block.callout.icon?.emoji && (
                  <span class="notion-callout-icon">
                    {block.callout.icon.emoji}
                  </span>
                )}
                {block.callout?.rich_text[0]?.plain_text || ""}
              </div>
            );
          default:
            return null; // Manejar otros tipos si es necesario
        }
      })
    }
  </Container>
</Layout>

<style>
  .notion-heading-1 {
    font-size: 2rem;
    font-weight: bold;
    margin: 1rem 0;
  }

  .notion-heading-2 {
    font-size: 1.75rem;
    font-weight: bold;
    margin: 0.75rem 0;
  }

  .notion-heading-3 {
    font-size: 1.5rem;
    font-weight: bold;
    margin: 0.5rem 0;
  }

  .notion-paragraph {
    font-size: 1rem;
    line-height: 1.6;
    margin: 0.5rem 0;
  }

  .notion-bulleted-list {
    margin-left: 1.5rem;
    list-style-type: disc; /* Asegura que se vean los puntos */
  }

  .notion-numbered-list {
    margin-left: 1.5rem;
    list-style-type: decimal; /* Asegura que se vean los números */
  }

  .notion-list-item {
    font-size: 1rem;
    line-height: 1.6;
  }

  .notion-to-do {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0.5rem 0;
  }

  .notion-quote {
    font-style: italic;
    padding-left: 1rem;
    border-left: 4px solid #ccc;
    margin: 1rem 0;
  }

  .notion-divider {
    border: none;
    border-top: 1px solid #ddd;
    margin: 1rem 0;
  }

  .notion-code {
    background: #f4f4f4;
    padding: 1rem;
    border-radius: 8px;
    overflow-x: auto;
    margin: 1rem 0;
  }

  .notion-image img {
    max-width: 100%;
    border-radius: 8px;
    margin: 1rem 0;
  }

  .notion-callout {
    display: flex;
    align-items: center;
    padding: 1rem;
    background: #f9f9f9;
    border-left: 4px solid #0077ff;
    margin: 1rem 0;
    border-radius: 4px;
  }

  .notion-callout-icon {
    margin-right: 0.5rem;
  }
</style>
