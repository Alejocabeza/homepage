---
import Layout from "@/layouts/Layout.astro";
import { getCV } from "@/lib/navigation.ts";
import ProjectCard from "@/components/ui/card/project.astro";
import { getPublishedProjects } from "@/lib/notion.ts";

interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;
const { currentLocale } = Astro;
const cv = await getCV(currentLocale);
const projects = await getPublishedProjects();
---

<Layout
  title={cv.projectsTitle}
  description={cv.projectsDescription}
  lang={currentLocale}
>
  <main class="py-32 md:py-36 px-4 md:px-0">
    <h1
      class="text-4xl font-bold tracking-tight text-text-primary sm:text-5xl mb-10"
    >
      {cv.projectsTitle}
    </h1>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {projects.map((project) => <ProjectCard 
        title={project.name} 
        description={project.description} 
        href={project.url} 
        tags={project.stack}
        lang={lang}
        slug={project.slug}
      />)}
    </div>
  </main>
</Layout>
