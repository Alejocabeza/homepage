---
import Layout from "@/layouts/Layout.astro";
import { getCV } from "@/lib/navigation.ts";
import ProjectCard from "@/components/ui/card/project.astro";
import { getPublishedProjects } from "@/lib/notion.ts";

interface Props {
  lang?: "es" | "en";
}

const { lang: propLang } = Astro.props;
const { currentLocale } = Astro;
// Normalize locale to a typed lang with fallback to 'en'
const lang: "es" | "en" = (propLang ?? currentLocale ?? "en") as "es" | "en";
const cv = await getCV(lang);
const projects = await getPublishedProjects();
---

<Layout
  title={cv.projectsTitle}
  description={cv.projectsDescription}
  lang={lang}
>
  <main class="py-32 md:py-36 px-4 md:px-0">
    <h1
      class="text-4xl font-bold tracking-tight text-text-primary sm:text-5xl mb-10"
    >
      {cv.projectsTitle}
    </h1>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {
        projects.map((project) => (
          <ProjectCard
            title={project.name}
            description={project.description}
            href={project.url}
            tags={project.stack}
            lang={lang}
            slug={project.slug}
          />
        ))
      }
    </div>
  </main>
</Layout>
