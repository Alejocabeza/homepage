---
import Layout from "@/layouts/Layout.astro";
import About from "@/section/home/about.astro";
import Experience from "@/section/home/experience.astro";
import Hero from "@/section/home/hero.astro";

import es from "@/i18n/es.json";
import en from "@/i18n/en.json";

const { currentLocale } = Astro;
const lang = currentLocale === "es" ? es : en;
---

<Layout title={lang.metadata.title} description={lang.metadata.description} lang={currentLocale}>
  <Hero lang={currentLocale} />
  <Experience lang={currentLocale} />
  <About lang={currentLocale} />
</Layout>
