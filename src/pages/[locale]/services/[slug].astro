---
import marked from '@/lib/marked';
import Layout from '@/layouts/Layout.astro';
import { getPublishedServices, getServiceBySlug } from '@/lib/notion.ts';
import { getCV } from '@/lib/navigation.ts';

export async function getStaticPaths() {
  const allServices = await getPublishedServices();
  const locales = ['en', 'es'];
  
  const paths = [];
  for (const service of allServices) {
    for (const locale of locales) {
      paths.push({
        params: { slug: service.slug, locale },
      });
    }
  }
  return paths;
}

const { slug, locale } = Astro.params;
const { currentLocale } = Astro;

if (!slug) {
  return Astro.redirect('/404');
}

const service = await getServiceBySlug(slug);
const cv = await getCV(currentLocale);

if (!service) {
  return Astro.redirect('/404');
}

let renderedContent = marked(service.content || '');
if (service.htmlPlaceholders) {
  service.htmlPlaceholders.forEach((originalHtml, index) => {
    const placeholder = `__HTML_CODE_PLACEHOLDER_${index}__`;
    renderedContent = renderedContent.replace(placeholder, originalHtml);
  });
}
---

<Layout title={service.name} description={service.description} lang={currentLocale}>
  <main class="py-32 md:py-36 px-4 md:px-0 max-w-3xl mx-auto">
    <article>
      <h1 class="text-4xl font-bold tracking-tight text-text-primary sm:text-5xl mb-4">{service.name}</h1>
      <p class="text-lg text-text-secondary mb-8">{service.description}</p>
      
      <div class="prose prose-lg max-w-none text-text-secondary" set:html={renderedContent} />
    </article>

    <!-- CTA Section -->
    <aside class="text-center pt-16 pb-24">
      <h2 class="text-3xl font-semibold text-text-primary mb-4">¿Interesado en este servicio?</h2>
      <p class="text-text-secondary mb-8">Hablemos de cómo puedo ayudar a tu proyecto a crecer.</p>
      <a href={`mailto:${cv.basics.email}`} 
         class="inline-block bg-accent text-primary font-bold py-3 px-8 rounded-lg hover:bg-accent/90 transition-colors duration-300">
        Contáctame
      </a>
    </aside>
  </main>
</Layout>

<style is:global>
  .prose {
    color: var(--text-secondary);
  }
  .prose h1, .prose h2, .prose h3, .prose h4, .prose h5, .prose h6 {
    color: var(--text-primary);
  }
  .prose h3 {
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--accent);
    margin-top: 3rem;
    margin-bottom: 1.5rem;
  }
  .prose a {
    color: var(--accent);
    text-decoration: none;
    transition: opacity 0.3s ease;
  }
  .prose a:hover {
    opacity: 0.8;
  }
  .prose strong {
    color: var(--text-primary);
  }
  .prose code {
    color: var(--accent);
    background-color: var(--bg-secondary);
    padding: 0.2em 0.4em;
    border-radius: 0.3em;
    font-weight: 600;
  }
  .prose pre {
    background-color: var(--bg-secondary);
    border: 1px solid var(--accent-hover, #224444);
    padding: 1.5em;
    border-radius: 0.5em;
  }
  .prose pre code {
    padding: 0;
    background-color: transparent;
    font-weight: normal;
  }
</style>
