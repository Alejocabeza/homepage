---
import Layout from "@/layouts/Layout.astro";
import { getPublishedServices } from "@/lib/notion.ts";
import ServiceCard from "@/components/ui/card/service.astro";

const { currentLocale } = Astro;

const services = await getPublishedServices();
---

<Layout
  title="Servicios"
  description="Una lista de los servicios que ofrezco como desarrollador de software."
  lang={currentLocale}
>
  <main class="py-32 md:py-36 px-4 md:px-0">
    <h1
      class="text-4xl font-bold tracking-tight text-text-primary sm:text-5xl mb-10"
    >
      Mis Servicios
    </h1>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {services.map((service) => <ServiceCard {...service} locale={currentLocale} />)}
    </div>
  </main>
</Layout>
