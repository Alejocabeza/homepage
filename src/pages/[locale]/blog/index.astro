---
import Layout from "@/layouts/Layout.astro";
import { getPublishedPosts, type Post } from "@/lib/notion";
import ProjectCard from "@/components/ui/card/project.astro";

const { currentLocale } = Astro;

// Obtenemos los posts desde Notion en lugar de archivos locales
const posts: Omit<Post, "content">[] = await getPublishedPosts();
---

<Layout
  title="Blog"
  description="Artículos y tutoriales sobre desarrollo de software."
  lang={currentLocale}
>
  <main class="py-32 md:py-36 px-4 md:px-0">
    <h1
      class="text-4xl font-bold tracking-tight text-text-primary sm:text-5xl mb-10"
    >
      Blog
    </h1>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {
        posts.map((post) => (
          <ProjectCard
            title={post.title}
            description={post.excerpt}
            href={`/${currentLocale}/blog/${post.slug}`}
            tags={post.tags}
            status={post.category}
            author={post.author}
            author_avatar={post.author_avatar}
          />
        ))
      }
    </div>
  </main>
</Layout>
