---
import SocialShare from '@/shared/components/social-share.astro';

type Props = {
  project: any;
  renderedContent: string | null;
  projectUrl: string;
};

const { project, renderedContent, projectUrl } = Astro.props as Props;
---

<main class="py-24 px-6 md:px-0 max-w-3xl mx-auto">
  <article>
    <!-- Back link -->
    <a href="/projects" class="inline-flex items-center gap-2 text-sm text-text-muted hover:text-accent transition-colors mb-8">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>
      </svg>
      Volver a proyectos
    </a>

    <!-- Title -->
    <h1 class="text-3xl sm:text-4xl font-semibold text-white mb-4">
      {project.name}
    </h1>

    <!-- Description -->
    <p class="text-base text-text-secondary mb-6">
      {project.description}
    </p>

    <!-- Stack tags -->
    <div class="flex flex-wrap gap-2 mb-6">
      {
        project.stack &&
          project.stack.map((tech: string) => (
            <span class="px-2.5 py-1 text-xs text-text-muted bg-secondary rounded border border-border">
              {tech}
            </span>
          ))
      }
    </div>

    <!-- Live link -->
    {
      project.url && (
        <a
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm font-medium text-accent hover:text-accent/80 transition-colors mb-10"
        >
          Ver proyecto en vivo
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
        </a>
      )
    }

    <!-- Content -->
    <div class="prose prose-invert max-w-none text-text-secondary prose-headings:text-white prose-a:text-accent prose-strong:text-white">
      <Fragment set:html={renderedContent} />
    </div>
  </article>

  <!-- Social Share -->
  <div class="mt-12 pt-8 border-t border-border">
    <SocialShare title={project.name} url={projectUrl} />
  </div>
</main>