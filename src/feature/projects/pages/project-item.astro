---
type Props = {
  project: any;
  renderedContent: string | null;
};
const { project, renderedContent } = Astro.props as Props;
---

<main class="py-32 md:py-36 px-4 md:px-0 max-w-3xl mx-auto">
  <article>
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl mb-4">
      {project.name}
    </h1>

    <div class="flex flex-wrap gap-2 mb-4">
      {
        project.stack &&
          project.stack.map((tech: any) => (
            <span class="bg-accent/10 text-accent text-xs font-medium px-3 py-1 rounded-full">
              {tech}
            </span>
          ))
      }
    </div>

    {
      project.url && (
        <a
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
          class=" hover:text-accent transition-colors duration-300 z-10 inline-flex items-center gap-1 mb-8"
        >
          Ver proyecto en vivo
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-arrow-up-right-from-square"
          >
            <path d="M21 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h6" />
            <path d="m21 3-9 9" />
            <path d="M15 3h6v6" />
          </svg>
        </a>
      )
    }

    <div
      class="prose prose-lg max-w-none mt-10 text-text-secondary"
      set:html={renderedContent}
    />
  </article>
</main>
