---
import { getPublishedProjects, type Project } from "@/shared/lib/notion";
import Card from '@/shared/components/ui/card.astro';

const projects: Omit<Project, 'content'>[] = await getPublishedProjects();
---

<main class="py-32 md:py-36 px-4 md:px-0">
  <h1 class="text-4xl font-bold tracking-tight sm:text-5xl mb-10">
    Mis Proyectos
  </h1>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    {
      projects.map((project) => (
        <Card
          title={project.name}
          description={project.description}
          href={`/projects/${project.slug}`}
          tags={project.stack}
          slug={project.slug}
        />
      ))
    }
  </div>
</main>
