---
import { getPublishedProjects, type Project } from "@/shared/lib/notion";
import Card from '@/shared/components/ui/card.astro';

const projects: Omit<Project, 'content'>[] = await getPublishedProjects();
---

<main class="py-24 px-6 md:px-0">
  <header class="mb-12">
    <h1 class="text-3xl sm:text-4xl font-semibold text-gray-900 mb-4">
      Proyectos
    </h1>
    <p class="text-base text-text-secondary max-w-xl">
      Selección de proyectos que demuestran experiencia en arquitectura backend, APIs escalables y soluciones cloud.
    </p>
  </header>
  
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 animate-grid">
    {
      projects.map((project) => (
        <Card
          title={project.name}
          description={project.description}
          href={`/projects/${project.slug}`}
          tags={project.stack}
          slug={project.slug}
        />
      ))
    }
  </div>
</main>