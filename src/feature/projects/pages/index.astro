---
import { getPublishedProjects } from "@/shared/lib/notion";
import ProjectCard from "@/feature/projects/components/card.astro";

const projects = await getPublishedProjects();
---

<main class="py-32 md:py-36 px-4 md:px-0">
  <h1 class="text-4xl font-bold tracking-tight sm:text-5xl mb-10">
    Mis Proyectos
  </h1>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    {
      projects.map((project) => (
        <ProjectCard
          title={project.name}
          description={project.description}
          href={project.url}
          tags={project.stack}
          slug={project.slug}
        />
      ))
    }
  </div>
</main>
