---
import {getPublishedPosts, type Post} from '@/shared/lib/notion';
import Card from '@/shared/components/ui/card.astro';

const posts: Omit<Post, "content">[] = await getPublishedPosts();
---

<main class="py-24 px-6 md:px-0">
  <header class="mb-12" data-reveal>
    <h1 class="text-3xl sm:text-4xl font-semibold text-black mb-4">
      Blog
    </h1>
    <p class="text-base text-text-secondary max-w-xl">
      Artículos sobre desarrollo backend, arquitecturas escalables y mejores prácticas.
    </p>
  </header>
  
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 animate-grid">
    {
      posts.map((post) => (
        <Card
          title={post.title}
          description={post.excerpt}
          href={`/blog/${post.slug}`}
          tags={post.tags}
          status={post.category}
          author={post.author}
          author_avatar={post.author_avatar}
          slug={post.slug}
        />
      ))
    }
  </div>
</main>
