---
import { basics } from "@/shared/data/cv.json";
import Badge from "../components/badge.astro";
import DownloadButton from "../components/download-button.astro";

const primaryEmail = basics.email;
const location = `${basics.location.city}, ${basics.location.region}`;
---

<section
  id="presentacion"
  class="py-24 sm:py-32 md:py-40 w-full flex justify-center items-start flex-col max-w-full px-6 md:px-0"
  aria-labelledby="presentacion-heading"
>
  <div class="max-w-3xl w-full">
    <!-- Badge de disponibilidad -->
    <div class="mb-6">
      <Badge
        isAvailable={basics.available}
        availableText={basics.availableForWork}
        notAvailableText={basics.notAvailableForWork}
      />
    </div>

    <!-- Título principal -->
    <h1 id="presentacion-heading" class="text-4xl sm:text-5xl md:text-6xl font-semibold tracking-tight text-text-primary mb-4">
      {basics.name}
    </h1>

    <!-- Label profesional -->
    <p class="text-xl sm:text-2xl text-laravel font-medium mb-3">
      {basics.label}
    </p>

    <!-- Ubicación -->
    <p class="text-base text-text-muted mb-8">
      {location}
    </p>

    <!-- Resumen de valor -->
    <p
      class="text-lg text-text-secondary leading-relaxed mb-10 max-w-2xl"
      set:html={basics.heroSummary}
    />

    <!-- CTAs -->
    <div class="flex flex-wrap gap-4">
      <!-- Botón primario: Contactar -->
      <a
        href={`mailto:${primaryEmail}?subject=Contacto - Portfolio Laravel Specialist`}
        class="inline-flex items-center justify-center gap-2 px-6 py-3 text-sm font-medium text-white bg-laravel rounded-lg transition-all hover:bg-laravel/90 hover:scale-[1.02]"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
        </svg>
        Contactarme
      </a>

      <!-- Botón secundario: Descargar CV -->
      <DownloadButton url={basics.cvUrl} fileName="cv-alejandro-cabeza.pdf" />
    </div>
  </div>
</section>
