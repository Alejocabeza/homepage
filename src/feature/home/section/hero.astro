---
import { basics } from "@/shared/data/cv.json";
import Badge from "../components/badge.astro";
import DownloadButton from "../components/download-button.astro";
---

<section
  id="presentacion"
  class="py-24 sm:py-32 md:py-36 w-full flex justify-center items-start flex-col max-w-full px-4 md:px-0"
  aria-labelledby="presentacion-heading"
>
  <div class="max-w-full">
    <div class="flex flex-col gap-4 mb-4">
      <img
        class="rounded-full shadow-lg size-24 sm:size-32"
        src="/avatar.png"
        alt={basics.name}
      />
      <div class="flex justify-start items-start flex-col gap-3">
        <div class='flex justify-center items-center flex-row gap-3'>
          <Badge
            isAvailable={basics.available}
            availableText={basics.availableForWork}
            notAvailableText={basics.notAvailableForWork}
          />
          <DownloadButton url={basics.cvUrl} fileName="cv-alejandro-cabeza.pdf" />
        </div>
        <p class="text-sm">
          {basics.location.city} - {basics.location.region}
        </p>
      </div>
    </div>
  </div>
  <h1 id="presentacion-heading" class="text-3xl font-bold tracking-tight sm:text-4xl md:text-5xl">
    {basics.name}
  </h1>
  <p
    class="mt-6 text-lg sm:text-xl [&>strong]:text-accent [&>strong]:font-semibold sm:w-full tracking-tight"
    set:html={basics.heroSummary}
  />
</section>
