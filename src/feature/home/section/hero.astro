---
import { basics } from "@/shared/data/cv.json";
import Badge from "../components/badge.astro";
---

<div
  class="py-32 md:py-36 w-full flex justify-center items-start flex-col max-w-full px-4 md:px-0"
>
  <div class="max-w-full">
    <div class="flex flex-col gap-4 mb-4">
      <img
        class="rounded-full shadow-lg size-32"
        src="/avatar.png"
        alt={basics.name}
      />
      <div class="flex justify-start items-center flex-col gap-3">
        <Badge
          isAvailable={basics.available}
          availableText={basics.availableForWork}
          notAvailableText={basics.notAvailableForWork}
        />
        <p class="text-sm text-secondary">
          {basics.location.city} - {basics.location.region}
        </p>
      </div>
    </div>
  </div>
  <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
    {basics.name}
  </h1>
  <p
    class="mt-6 text-xl [&>strong]:text-accent [&>strong]:font-semibold sm:w-full tracking-tight"
    set:html={basics.heroSummary}
  />
</div>
