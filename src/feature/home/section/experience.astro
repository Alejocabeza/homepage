---
import { work } from "@/shared/data/cv.json";
import Items from "@/feature/home/components/items.astro";
---

<section id="experiencia" class="py-16">
  <h2 class="text-2xl font-semibold text-text-primary mb-12">
    Experiencia
  </h2>
  
  <div class="relative">
    <!-- Timeline line -->
    <div class="absolute left-[7px] top-2 bottom-0 w-px bg-border"></div>
    
    <div class="space-y-2">
      {
        work.map((experience) => (
          <Items {...experience} />
        ))
      }
    </div>
  </div>
</section>
