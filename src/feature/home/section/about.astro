---
import { basics } from "@/shared/data/cv.json";
---

<section id="sobre-mi" class="py-32 md:py-36 px-4 md:px-0">
  <h2
    id="sobre-mi-heading"
    class="flex mb-6 text-3xl font-semibold gap-x-3 text-text-primary"
  >
    Sobre mí
  </h2>
  <article
    class="flex flex-col items-center justify-center gap-8 text-text-secondary md:flex-row mt-16"
  >
    <div
      class="[&>p]:mb-4 [&>p>strong]:text-accent [&>p>strong]:font-normal [&>p>strong]:font-mono order-2 md:order-1 text-pretty"
    >
      {basics.aboutMe.map((text) => <p>{text}</p>)}
    </div>

    <img
      width="200"
      height="200"
      src="/avatar.png"
      alt={basics.name}
      class="order-1 object-cover w-48 sm:w-56 md:w-64 h-full p-1 md:order-2 rotate-3 lg:p-2 lg:w-64 aspect-square rounded-2xl bg-bg-secondary ring-1 ring-accent/20 mb-8 sm:mb-0"
      style="object-position: 50% 50%"
    />
  </article>
</section>
