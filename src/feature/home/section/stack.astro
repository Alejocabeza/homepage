---
import TechBadge from "@/feature/home/components/tech-badge.astro";
import { skills } from "@/shared/data/cv.json";

const primarySkills = skills.primary || [];
const secondarySkills = skills.secondary || [];
---

<section id="stack" class="py-16">
  <h2 class="text-2xl font-semibold text-text-primary mb-2">
    Mi Stack
  </h2>
  <p class="text-text-muted mb-10 max-w-xl">
   -stack TALL (Tailwind, Alpine, Livewire, Laravel) + tecnologías que uso para construir productos robustos
  </p>

  <!-- Primary technologies - Stack TALL -->
  <div class="mb-8">
    <h3 class="text-sm font-medium text-text-muted uppercase tracking-wide mb-4">
      Stack TALL
    </h3>
    <div class="flex flex-wrap gap-3">
      {primarySkills.map((skill: any) => (
        <TechBadge 
          name={skill.name} 
          category="primary" 
          level={skill.level}
          showDots={true}
        />
      ))}
    </div>
  </div>

  <!-- Secondary technologies -->
  <div>
    <h3 class="text-sm font-medium text-text-muted uppercase tracking-wide mb-4">
      Tecnologías Adicionales
    </h3>
    <div class="flex flex-wrap gap-3">
      {secondarySkills.map((skill: any) => (
        <TechBadge 
          name={skill.name} 
          category="secondary" 
          level={skill.level}
          showDots={false}
        />
      ))}
    </div>
  </div>
</section>
