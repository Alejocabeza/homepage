---
interface Props {
  url: string;
  fileName: string;
}

const { url, fileName } = Astro.props;
---

<a
  href={url}
  download={fileName}
  target="_blank"
  class="inline-flex items-center justify-center gap-2 px-6 py-3 text-sm font-medium text-text-secondary border border-border rounded-lg transition-all hover:border-laravel hover:text-laravel"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
    <polyline points="7 10 12 15 17 10" />
    <line x1="12" y1="15" x2="12" y2="3" />
  </svg>
  Descargar CV
</a>
