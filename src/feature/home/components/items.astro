---

interface Props {
  name: string;
  summary: string;
  startDate: string;
  endDate: string;
  position: string;
  highlights?: string[];
  url: string;
}

const { name, summary, startDate, endDate, position, highlights, url } =
  Astro.props;

const getDate = (startDate: string, endDate: string) => {
  if (startDate === endDate) return startDate;
  if (startDate && !endDate) return `${startDate} - Actualmente...`;
  if (startDate && endDate) {
    return `${startDate} - ${endDate}`;
  }
};
---

<div
  class="relative mx-12 pb-12 grid before:absolute before:left-[-35px] before:block before:h-full before:border-l-2 before:border-[#ffffff30] before:content-[''] md:grid-cols-5 md:gap-10 md:space-x-4]"
>
  <div class="relative pb-12 md:col-span-2">
    <div class="sticky top-0">
      <span class="text-accent -left-[42px] absolute rounded-full text-5xl"
        >&bull;</span
      >
      <div class="flex flex-row items-center gap-1">
        <h3 class="text-2xl font-bold text-accent">{name}</h3>
        {
          url && (
            <a
              class="text-accent hover:text-accent/80 text-xl font-bold"
              href={url}
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-eye"
              >
                <>
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" />
                  <path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6" />
                </>
              </svg>
            </a>
          )
        }
      </div>
      <h4 class="font-semibold text-xl text-text-primary">
        {position}
      </h4>
      <time class="p-0 m-0 text-sm text-text-secondary">
        {getDate(startDate, endDate)}
      </time>
    </div>
  </div>
  <p
    class="relative pb-4 text-text-secondary md:col-span-3 text-pretty [&>span]:text-accent [&>span]:font-semibold [&>a]:text-blue-500 [&>a]:transition-colors [&>a]:duration-150 [&>a]:hover:text-blue-400"
    set:html={summary}
  />
</div>
