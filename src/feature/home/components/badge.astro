---
interface Props {
  isAvailable: boolean;
  availableText: string;
  notAvailableText: string;
}

const { isAvailable, availableText, notAvailableText } = Astro.props;
---

<div class="inline-flex items-center gap-2">
  <span class={`w-2 h-2 rounded-full ${isAvailable ? 'bg-laravel' : 'bg-red-500'}`}></span>
  <span class={`text-sm font-medium ${isAvailable ? 'text-laravel' : 'text-red-500'}`}>
    {isAvailable ? availableText : notAvailableText}
  </span>
</div>