---
interface Props {
    title?: string
    toPrint?: string
}
const {title, toPrint} = Astro.props
---

<section class="[&>h2]:mb-[8px] [&>h2]:font-bold [&>h2]:leading-normal [&>h2]:text-[1.5rem] [&>h2]:text-center md:[&>h2]:text-start">
    {title && <h2>{title}</h2>}
    <slot />
</section>

<style>
    section {
        margin: 0 auto 48px;
    }
</style>
