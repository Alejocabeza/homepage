---
import type { Projects } from "@/interfaces/repos.interface";

interface Props extends Projects {}

const {
  description,
  github,
  highlights,
  name,
  isActive,
  status,
  url,
} = Astro.props;
---

<div
  class="max-w-sm bg-pink-500/20 border border-pink-500/20 rounded-lg shadow dark:bg-pink-800 dark:border-pink-700"
>
  <a href={isActive ? url : github} target="_blank">
    <img class="rounded-t-lg" src="/docs/images/blog/image-1.jpg" alt="" />
  </a>
  <div class="p-5 max-w-full">
    <a href={isActive ? url : github} target="_blank">
      <h5
        class="mb-2 text-2xl font-bold tracking-tight text-gray-900 dark:text-white capitalize"
      >
        {name.split("-").join(" ")}
      </h5>
    </a>
    <p class="my-4 font-normal text-gray-700 dark:text-gray-400 text-pretty">
      {description}
    </p>
    <p
      class="my-4 font-normal text-gray-700 dark:text-gray-400 flex justify-start items-center gap-2 flex-row max-w-full flex-wrap"
    >
      {
        highlights.map((lang) => (
          <span class="bg-pink-100 text-pink-800 text-xs font-bold px-2.5 py-0.5 rounded dark:bg-pink-900 dark:text-pink-300 max-w-full">
            {lang}
          </span>
        ))
      }
    </p>
    <a
      href={isActive ? url : github}
      target="_blank"
      class="inline-flex items-center px-3 py-2 text-sm font-medium text-center text-white bg-pink-700 rounded-lg hover:bg-pink-800 focus:ring-4 focus:outline-none focus:ring-pink-300 dark:bg-pink-600 dark:hover:bg-pink-700 dark:focus:ring-pink-800"
    >
       {isActive ? "Ver Proyecto" : "Ver Repositorio"}
      <svg
        class="rtl:rotate-180 w-3.5 h-3.5 ms-2"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 14 10"
      >
        <path
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M1 5h12m0 0L9 1m4 4L9 9"></path>
      </svg>
    </a>
  </div>
</div>
