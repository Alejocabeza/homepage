---
import type { Results } from "@/interfaces/post.interface"
interface Props extends Results {}
const { cover, id, properties } = Astro.props;
---

<div
  class="max-w-sm bg-pink-200/50 backdrop-blur border border-gray-200 rounded-lg shadow-lg dark:bg-gray-800 dark:border-gray-700"
>
  <a href={`/blog/${id}`}>
    <img
      class="rounded-t-lg h-[18rem] w-full object-cover"
      src={cover?.external.url}
      alt=""
    />
  </a>
  <div class="p-5 flex flex-col gap-1">
    <span
      class="bg-pink-300 rounded-md px-2 py-1 w-max font-bold mb-2 text-center"
    >
      {properties.tags.select.name}
    </span>
    <a href={`/blog/${id}`}>
      <h5
        class="mb-2 text-2xl font-bold tracking-tight text-gray-900 dark:text-white line-clamp-3"
      >
        {properties.name?.title[0]?.plain_text}
      </h5>
    </a>
    <p
      class="mb-3 font-normal text-gray-700 dark:text-gray-400 text-wrap line-clamp-3"
    >
      {properties.description.rich_text[0].plain_text}
    </p>
    <a
      href={`/blog/${id}`}
      class="inline-flex items-center px-3 py-2 text-sm font-medium text-center text-white bg-pink-700 rounded-lg hover:bg-pink-800 focus:ring-4 focus:outline-none focus:ring-pink-300 dark:bg-pink-600 dark:hover:bg-pink-700 dark:focus:ring-pink-800 w-max"
    >
      Leer más
      <svg
        class="rtl:rotate-180 w-3.5 h-3.5 ms-2"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 14 10"
      >
        <path
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M1 5h12m0 0L9 1m4 4L9 9"></path>
      </svg>
    </a>
  </div>
</div>
