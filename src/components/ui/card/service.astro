---
interface Props {
  name: string;
  description: string;
  slug: string;
  locale: string;
}

const { name, description, slug, locale } = Astro.props;
const url = `/${locale}/services/${slug}`;
---

<div
  class="group relative bg-bg-secondary rounded-lg shadow-lg p-6 flex flex-col justify-between transition-all duration-300 ease-in-out hover:scale-[1.02] hover:shadow-2xl hover:shadow-accent/10 border border-slate-800 hover:border-accent/20"
>
  <div class="flex-grow">
    <header class="flex justify-between items-start mb-4">
      <h3
        class="text-xl font-bold text-text-primary group-hover:text-accent transition-colors duration-300"
      >
        <a
          href={url}
          class="after:absolute after:inset-0"
        >
          {name}
        </a>
      </h3>
    </header>
    <p class="text-text-secondary mb-4 text-sm">{description}</p>
  </div>

  <footer class="flex flex-wrap gap-2 mt-auto">
    <span class="text-accent text-xs font-medium">
      Leer más
    </span>
  </footer>
</div>
