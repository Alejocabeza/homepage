---
import { basics } from "@cv";

const isAvailable = basics.available;
---

<div class="flex items-center">
  <span class="relative inline-flex overflow-hidden rounded-full p-[1px]">
    {
      isAvailable ? (
        <span class="absolute inset-[-1000%] animate-[spin_2s_linear_infinite] bg-[conic-gradient(from_90deg_at_50%_50%,#51E4B8_0%,#21554E_50%,#51E4B8_100%)]" />
      ) : (
        <span class="absolute inset-[-1000%] animate-[spin_2s_linear_infinite] bg-[conic-gradient(from_90deg_at_50%_50%,#ef4444_0%,#7f1d1d_50%,#ef4444_100%)]" />
      )
    }
    <div
      class:list={[
        "inline-flex items-center justify-center w-full px-3 py-1 text-sm font-semibold rounded-full cursor-default backdrop-blur-3xl whitespace-nowrap",
        isAvailable ? "text-accent bg-accent/20" : "text-red-400 bg-red-400/20",
      ]}
    >
      {isAvailable ? "Disponible para Trabajar" : "No Disponible Actualmente"}
    </div>
  </span>
</div>
