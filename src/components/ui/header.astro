---
import { getNavigation } from "@/lib/navigation";

interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;

const newLang = lang === "es" ? "en" : "es";
const currentPath = Astro.url.pathname.replace(`/${lang}`, "");
const newUrl = `/${newLang}${currentPath === "" ? "/" : currentPath}`;
---

<header
  class="fixed top-0 z-10 flex items-center justify-center w-full mx-auto mt-2"
>
  <nav
    class="flex px-3 text-[1rem] font-medium rounded-full text-text-secondary justify-center items-center"
  >
    {
      getNavigation(lang).map(
        ({ title, url, icon }: { title: string; url: string; icon: any }) => (
          <a
            class="relative block px-2 py-2 transition hover:text-accent"
            aria-label={title}
            href={`/${lang}${url === '/' ? '' : url}`}
          >
            {title}
          </a>
        )
      )
    }
    <div class="ml-4"> 
      <button
        id="lang-toggle"
        class="relative block px-2 py-2 transition hover:text-accent"
        aria-label="Change language"
        data-new-url={newUrl}
      >
        {newLang.toUpperCase()}
      </button>
    </div>
  </nav>
</header>

<script>
  const langToggleButton = document.getElementById("lang-toggle");
  if (langToggleButton) {
    console.log("Language toggle button found!", langToggleButton);
    const newUrlFromData = langToggleButton.dataset.newUrl;
    langToggleButton.addEventListener("click", () => {
      console.log("Button clicked! Redirecting to:", newUrlFromData);
      if (newUrlFromData) {
        window.location.href = newUrlFromData;
      } else {
        console.error("newUrlFromData is undefined!");
      }
    });
  } else {
    console.error("Language toggle button not found!");
  }

  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll("section");
    const navItems = document.querySelectorAll("header nav a");

    const callback = (entries: any[]) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navItems.forEach((item) => {
            if (item.getAttribute("arial-label") === entry.target.id) {
              item.classList.add("text-accent");
            } else {
              item.classList.remove("text-accent");
            }
          });
        }
      });
    };

    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: "0px",
      threshold: 0.3,
    });

    sections.forEach((section) => {
      observer.observe(section);
    });

    document.onvisibilitychange = () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect();
      } else {
        sections.forEach((section) => {
          observer.observe(section);
        });
      }
    };
  });
</script>

<style>
  nav {
    animation: nav-shadown 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  @keyframes nav-shadown {
    to {
      @apply shadow-lg ring-1 backdrop-blur bg-bg-secondary/90 ring-white/10;
    }
  }
</style>
