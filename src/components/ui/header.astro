---
import { NAVIGATION } from "@/lib/navigation";
---

<header
  class="fixed top-0 z-10 flex items-center justify-center w-full mx-auto mt-2"
>
  <nav
    class="flex px-3 text-[1rem] font-medium rounded-full text-text-secondary justify-center items-center"
  >
    {
      NAVIGATION.map(
        ({ title, url, icon }: { title: string; url: string; icon: any }) => (
          <a
            class="relative block px-2 py-2 transition hover:text-accent"
            aria-label={title}
            href={url}
          >
            {title}
          </a>
        )
      )
    }
    <!-- <ToggleTheme /> -->
  </nav>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll("section");
    const navItems = document.querySelectorAll("header nav a");

    const callback = (entries: any[]) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navItems.forEach((item) => {
            if (item.getAttribute("arial-label") === entry.target.id) {
              item.classList.add("text-accent");
            } else {
              item.classList.remove("text-accent");
            }
          });
        }
      });
    };

    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: "0px",
      threshold: 0.3,
    });

    sections.forEach((section) => {
      observer.observe(section);
    });

    document.onvisibilitychange = () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect();
      } else {
        sections.forEach((section) => {
          observer.observe(section);
        });
      }
    };
  });
</script>

<style>
  nav {
    animation: nav-shadown 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  @keyframes nav-shadown {
    to {
      @apply shadow-lg ring-1 backdrop-blur bg-bg-secondary/90 ring-white/10;
    }
  }
</style>
