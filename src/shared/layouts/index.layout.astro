---
import "@/shared/styles/global.css";
import Header from "@/shared/components/header.astro";
import siteMetadata, { absoluteUrl } from "@/shared/config/site";

type SeoProps = {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  type?: "website" | "article" | "profile" | string;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  datePublished?: string;
  dateModified?: string;
  keywords?: string[];
};

type Props = SeoProps;

const {
  title,
  description,
  canonical,
  ogImage,
  type = "website",
  noindex,
  structuredData,
  datePublished,
  dateModified,
  keywords,
} = Astro.props as Props;

const pageTitle = title
  ? `${title} | ${siteMetadata.siteName}`
  : siteMetadata.title;
const metaDescription = description ?? siteMetadata.description;
const currentUrl = Astro.url;
const defaultCanonical =
  canonical ||
  (siteMetadata.baseUrl
    ? new URL(
        `${currentUrl.pathname}${currentUrl.search}`,
        siteMetadata.baseUrl
      ).toString()
    : currentUrl.href);
const canonicalUrl = canonical ?? defaultCanonical;
const ogImageUrl = ogImage
  ? absoluteUrl(ogImage)
  : siteMetadata.defaultOgImage;
const robotsContent = noindex ? "noindex, nofollow" : "index, follow";
const resolvedKeywords = keywords ?? siteMetadata.keywords;

const schemaEntries = Array.isArray(structuredData)
  ? structuredData
  : structuredData
    ? [structuredData]
    : [];

const defaultSchemas: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteMetadata.siteName,
    url: siteMetadata.baseUrl,
    description: metaDescription,
    inLanguage: "es",
    publisher: {
      "@type": "Person",
      name: siteMetadata.author,
    },
    sameAs: siteMetadata.sameAs,
  },
];

const jsonLdSchemas = [...defaultSchemas, ...schemaEntries];
const mermaidScriptSrc = (await import("../scripts/mermaid-init.js?url"))
  .default;
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={robotsContent} />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    {resolvedKeywords.length > 0 && (
      <meta name="keywords" content={resolvedKeywords.join(", ")} />
    )}
    <meta name="author" content={siteMetadata.author} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta name="theme-color" content="#03112b" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteMetadata.siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:locale" content="es_ES" />
    {ogImageUrl && (
      <>
        <meta property="og:image" content={ogImageUrl} />
        <meta name="twitter:image" content={ogImageUrl} />
      </>
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    {siteMetadata.twitterHandle && (
      <>
        <meta name="twitter:site" content={siteMetadata.twitterHandle} />
        <meta name="twitter:creator" content={siteMetadata.twitterHandle} />
      </>
    )}

    {type === "article" && datePublished && (
      <meta property="article:published_time" content={datePublished} />
    )}
    {type === "article" && (dateModified ?? datePublished) && (
      <meta
        property="article:modified_time"
        content={dateModified ?? datePublished}
      />
    )}

    {jsonLdSchemas.map((schema) => (
      <script type="application/ld+json">
        {JSON.stringify(schema)}
      </script>
    ))}
  </head>
<body class="relative text-text-primary bg-primary">
    <!-- <Header /> -->
    <main class="max-w-3xl mx-auto px-4 sm:px-6">
      <slot />
    </main>

    <script type="module" src={mermaidScriptSrc}></script>
  </body>
</html>
