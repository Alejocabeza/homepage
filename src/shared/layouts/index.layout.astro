---
import "@/shared/styles/global.css";
import Header from "@/shared/components/header.astro";

type Props = {
  title: string;
};

const { title }: Props = Astro.props;
const mermaidScriptSrc = (await import("../scripts/mermaid-init.js?url"))
  .default;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="relative text-primary bg-primary">
    <div
      class="absolute top-0 bottom-0 z-[-2] min-h-screen w-full
	bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(100,255,218,0.2),rgba(255,255,255,0))]"
    >
    </div>
    <Header />
    <main class="max-w-[700px] mx-auto">
      <slot />
    </main>
    <script type="module" src={mermaidScriptSrc}></script>
  </body>
</html>
