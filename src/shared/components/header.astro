---
import { NAVIGATION } from "@/shared/lib/navigation";
---

<header
  class="fixed top-0 z-10 flex items-center justify-center w-full mx-auto mt-2"
>
  <nav
    class="flex px-3 text-[16px] font-medium rounded-full text-text-secondary justify-center items-center"
  >
    {
      NAVIGATION.map(
        ({ title, url, icon }: { title: string; url: string; icon: any }) => (
          <a
            class="relative block px-2 py-2 transition hover:text-accent"
            aria-label={title}
            href={url}
          >
            {title}
          </a>
        )
      )
    }
  </nav>
</header>

<style>
  nav {
    animation: nav-shadown 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 6.25rem;
  }

  @keyframes nav-shadown {
    to {
      /* shadow-lg approx */
      box-shadow:
        0 0.625rem 0.9375rem -0.1875rem rgba(2, 6, 23, 0.7),
        0 0.25rem 0.375rem -0.125rem rgba(2, 6, 23, 0.06);
      /* ring-1 approximated with border */
      border-width: 0.0625rem;
      border-style: solid;
      border-color: rgba(255, 255, 255, 0.1); /* ring-white/10 */
      /* backdrop blur */
      backdrop-filter: blur(0.5rem);
      -webkit-backdrop-filter: blur(0.5rem);
      /* background color from bg-bg-secondary/90 */
      background-color: rgba(2, 12, 27, 0.9);
      border-radius: 624.9375rem;
    }
  }
</style>

<script>
  // language toggle functionality removed

  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll("section");
    const navItems = document.querySelectorAll("header nav a");

    const callback = (entries: any[]) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navItems.forEach((item) => {
            if (item.getAttribute("arial-label") === entry.target.id) {
              item.classList.add("text-accent");
            } else {
              item.classList.remove("text-accent");
            }
          });
        }
      });
    };

    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: "0rem",
      threshold: 0.3,
    });

    sections.forEach((section) => {
      observer.observe(section);
    });

    document.onvisibilitychange = () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect();
      } else {
        sections.forEach((section) => {
          observer.observe(section);
        });
      }
    };
  });
</script>
