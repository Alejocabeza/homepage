---
import {work} from '@cv'
import Items from '@/components/ui/section/expirence/items.astro'
import Container from '@/components/ui/container.astro'
---

<Container class='px-4 md:px-0'>
    <h2 class="flex mb-6 text-3xl font-semibold gap-x-3 text-black/80 dark:text-white">
        Experiencia
    </h2>
    <ol class="relative mt-16">
      {
        work.map((experiencie) => (
          <li>
            <Items {...experiencie} />
          </li>
        ))
      }
    </ol>
  </Container>