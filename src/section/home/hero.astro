---
import { basics } from "@cv";
import Badge from "@/components/ui/section/hero/badge.astro";
import Container from "@/components/ui/container.astro";
---

<Container
  class="py-32 md:py-36 w-full flex justify-center items-start flex-col max-w-full px-4 md:px-0"
>
  <div class="max-w-full">
    <div class="flex flex-col gap-4 mb-4">
      <img
        class="rounded-full shadow-lg size-32"
        src={basics.image}
        alt={basics.name}
      />
      <div class="flex justify-start items-center flex-col gap-2">
        <Badge>Disponible para Trabajar</Badge>
        <p class="text-sm text-gray-800/80">
          {basics.location.city} - {basics.location.region}
        </p>
      </div>
    </div>
  </div>
  <h1
    class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
  >
    Hey, {basics.name}
  </h1>
  <p
    class="mt-6 text-xl text-gray-800 dark:[&>strong]:text-pink-200 [&>strong]:text-pink-500 [&>strong]:font-semibold dark:text-gray-300 sm:w-full"
  >
<strong>Ingeniero Backend</strong> con experiencia en <strong>arquitecturas robustas y escalables</strong> utilizando <strong>Node.js (Nestjs, Express), PHP (Symfony, Laravel) y bases de datos PostgreSQL y MySQL</strong>. Como <strong>Lead Backend Engineer</strong>, he dirigido el desarrollo de aplicaciones enfocadas en <strong> calidad y eficiencia</strong>.
  </p>
</Container>
