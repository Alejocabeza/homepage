---
import type { Project } from "@/interfaces/project.interface";
import { findAllData, PROJECTDB } from "@/services/notion";
import Container from "@/components/ui/container.astro";
import Cards from "@/components/projects/ui/cards.astro";
const projects = await findAllData(PROJECTDB);
---

<Container class="py-32 md:py-36 max-w-full px-4 md:px-0">
  <h2
    class="flex mb-6 text-3xl font-semibold gap-x-3 text-black/80 dark:text-white"
  >
    Proyectos
  </h2>
  <div class="grid md:grid-cols-2 gap-2">
    {
      projects.results.map((project: Project) => {
        if (!project.archived && !project.in_trash) {
          return <Cards {...project} />;
        }
      })
    }
  </div>
</Container>
